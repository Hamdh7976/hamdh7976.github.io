---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts, formatDate, readingTime, slugify, type Post } from '../../utils';

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((post, i) => ({
		params: { id: post.id },
		props: { post, newer: posts[i - 1], older: posts[i + 1] },
	}));
}

interface Props {
	post: Post;
	newer?: Post;
	older?: Post;
}

const { post, newer, older } = Astro.props;
const { title, description, pubDate, updatedDate, tags } = post.data;
const { Content } = await render(post);
---

<Base title={title} description={description}>
	<article>
		<header class="post-header">
			<a class="back" href="/blog/">← All posts</a>
			<h1>{title}</h1>
			<div class="post-meta">
				<time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
				<span aria-hidden="true">·</span>
				<span>{readingTime(post.body)}</span>
				{updatedDate && <span>· Updated {formatDate(updatedDate)}</span>}
			</div>
			{tags.length > 0 && (
				<ul class="tags">
					{tags.map((t) => <li><a class="tag" href={`/tags/${slugify(t)}/`}>#{t}</a></li>)}
				</ul>
			)}
		</header>

		<div class="prose">
			<Content />
		</div>
	</article>

	<nav class="pager" aria-label="More posts">
		{older ? <a href={`/blog/${older.id}/`}><small>← Older</small>{older.data.title}</a> : <span />}
		{newer && <a class="next" href={`/blog/${newer.id}/`}><small>Newer →</small>{newer.data.title}</a>}
	</nav>
</Base>

<style>
	.post-header { margin-bottom: 2.5rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--border); }
	.post-header .post-meta { margin-bottom: 0.75rem; font-size: 0.95rem; }
	.back { display: inline-block; margin-bottom: 1.25rem; font-size: 0.9rem; text-decoration: none; }
	.pager { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 4rem; padding-top: 1.5rem; border-top: 1px solid var(--border); }
	.pager a { display: flex; flex-direction: column; text-decoration: none; color: var(--text); font-weight: 600; }
	.pager a:hover { color: var(--accent); }
	.pager small { color: var(--muted); font-weight: 400; }
	.pager .next { text-align: right; grid-column: 2; }
</style>
