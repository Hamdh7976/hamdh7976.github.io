---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { SITE, PROFILE, SOCIALS, SKILLS, EXPERIENCE, PROJECTS } from '../consts';
import { getPosts } from '../utils';

const recent = (await getPosts()).slice(0, 3);
const initials = SITE.name
	.split(/\s+/)
	.map((w) => w[0])
	.join('')
	.slice(0, 2)
	.toUpperCase();
---

<Base>
	<section class="hero">
		<div class="avatar" aria-hidden={!PROFILE.avatar}>
			{PROFILE.avatar ? <img src={PROFILE.avatar} alt={`Photo of ${SITE.name}`} /> : <span>{initials}</span>}
		</div>
		<div>
			<h1>{PROFILE.headline}</h1>
			<p class="role">{PROFILE.role} <span class="muted">· {PROFILE.location}</span></p>
		</div>
	</section>

	<p class="lead">{PROFILE.intro}</p>

	<div class="actions">
		{PROFILE.email && <a class="button primary" href={`mailto:${PROFILE.email}`}>Get in touch</a>}
		<a class={PROFILE.email ? 'button ghost' : 'button primary'} href="/blog/">Read the blog</a>
		{PROFILE.resumeUrl && <a class="button ghost" href={PROFILE.resumeUrl}>Résumé</a>}
	</div>

	<ul class="socials">
		{SOCIALS.map((s) => <li><a href={s.href} target="_blank" rel="noopener noreferrer">{s.label} ↗</a></li>)}
	</ul>

	<h2 id="about">About</h2>
	{PROFILE.about.map((p) => <p>{p}</p>)}

	<h2>Skills</h2>
	<ul class="tags">
		{SKILLS.map((s) => <li><span class="tag">{s}</span></li>)}
	</ul>

	<h2>Experience</h2>
	<ol class="timeline">
		{EXPERIENCE.map((e) => (
			<li>
				<span class="period">{e.period}</span>
				<div>
					<strong>{e.title}</strong> <span class="muted">· {e.org}</span>
					<p>{e.summary}</p>
				</div>
			</li>
		))}
	</ol>

	{PROJECTS.length > 0 && (
		<>
			<h2>Projects</h2>
			<div class="projects">
				{PROJECTS.map((p) => (
					<article class="project">
						<h3>{p.href ? <a href={p.href} target="_blank" rel="noopener noreferrer">{p.name} ↗</a> : p.name}</h3>
						<p>{p.description}</p>
					</article>
				))}
			</div>
		</>
	)}

	<div class="section-head">
		<h2>Recent writing</h2>
		<a href="/blog/">All posts →</a>
	</div>
	{recent.length ? (
		<ul class="post-list">{recent.map((post) => <PostCard post={post} />)}</ul>
	) : (
		<p class="muted">No posts yet. Check back soon.</p>
	)}
</Base>

<style>
	.hero { display: flex; align-items: center; gap: 1.5rem; margin-bottom: 1.5rem; }
	.avatar {
		flex: none; width: 6rem; height: 6rem; border-radius: 50%; overflow: hidden;
		display: grid; place-items: center;
		background: linear-gradient(135deg, var(--accent), color-mix(in srgb, var(--accent) 50%, #6b8cff));
		color: var(--bg); font-size: 2rem; font-weight: 700;
	}
	.avatar img { width: 100%; height: 100%; object-fit: cover; border-radius: 0; }
	.role { margin: 0; font-weight: 500; }
	.actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin: 1.75rem 0 1.25rem; }
	.socials { display: flex; flex-wrap: wrap; gap: 1.25rem; list-style: none; padding: 0; margin: 0; font-size: 0.95rem; }

	.timeline { list-style: none; padding: 0; margin: 0; display: grid; gap: 1.25rem; }
	.timeline li { display: grid; grid-template-columns: 9rem 1fr; gap: 1rem; }
	.timeline p { margin: 0.2rem 0 0; color: var(--muted); }
	.period { color: var(--muted); font-size: 0.9rem; padding-top: 0.1rem; font-variant-numeric: tabular-nums; }

	.projects { display: grid; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); gap: 1rem; }
	.project { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 1.1rem 1.25rem; }
	.project h3 { margin: 0 0 0.35rem; font-size: 1.05rem; }
	.project h3 a { color: var(--text); text-decoration: none; }
	.project h3 a:hover { color: var(--accent); }
	.project p { margin: 0; color: var(--muted); font-size: 0.95rem; }

	@media (max-width: 560px) {
		.hero { flex-direction: column; align-items: flex-start; }
		.timeline li { grid-template-columns: 1fr; gap: 0.1rem; }
	}
</style>
